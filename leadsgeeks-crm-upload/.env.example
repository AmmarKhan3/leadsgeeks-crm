# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.
# Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate once with:  openssl rand -base64 32
# Losing this key makes every stored client password unreadable. Keep a copy somewhere safe.
LOGIN_ENCRYPTION_KEY=

# Slack incoming webhook for team notifications (optional until set up)
SLACK_WEBHOOK_URL=

# Public URL of the app (used in emails and Slack links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
